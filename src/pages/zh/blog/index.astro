---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { localizePath, useTranslations, type Lang } from '../../../i18n/ui';
import { getBlogEntries, localizedField } from '../../../lib/content';
import { formatLongDate } from '../../../lib/format';

const lang: Lang = 'zh';
const t = useTranslations(lang);
const blogEntries = await getBlogEntries();
const [leadStory, ...otherStories] = blogEntries;
---

<SiteLayout
  lang={lang}
  title="Blog | CHY3"
  description="CHY3 平台更新、创意变现洞察与团队动态。"
>
  <main class="mx-auto max-w-7xl px-6 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24">
    <section class="max-w-4xl">
      <p class="font-display text-[11px] uppercase tracking-[0.28em] text-accent-blue">CHY3 Blog</p>
      <h1 class="mt-5 break-words font-display text-[2.85rem] leading-none font-bold text-white sm:text-6xl lg:text-7xl">Blog</h1>
      <p class="mt-7 max-w-3xl text-lg leading-8 text-white/65 sm:text-xl">
        来自 CHY3 团队的更新、洞察与创意变现实践分享。
      </p>
    </section>

    {leadStory ? (
      <a
        href={localizePath(`/blog/${leadStory.id}/`, lang)}
        class="group overlay-feature relative isolate mt-14 block overflow-hidden border border-white/10 bg-white/[0.03]"
      >
        <img src={leadStory.data.image} alt={localizedField(lang, leadStory.data.title, leadStory.data.titleEn)} class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]" />
        <div class="overlay-feature-scrim absolute inset-0" />
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_18%_18%,rgba(74,158,255,0.28),transparent_28%),radial-gradient(circle_at_78%_24%,rgba(240,192,112,0.14),transparent_22%)]" />

        <div class="relative z-10 flex min-h-[430px] items-end p-8 sm:min-h-[520px] sm:p-10 lg:min-h-[620px] lg:p-14">
          <div class="max-w-4xl">
            <div class="overlay-feature-meta flex flex-wrap items-center gap-3 text-sm">
              <span class="font-display text-[10px] uppercase tracking-[0.24em] text-warm-gold">{localizedField(lang, leadStory.data.desk, leadStory.data.deskEn)}</span>
              <span>•</span>
              <span>{formatLongDate(leadStory.data.publishedAt)}</span>
            </div>
            <h2 class="overlay-feature-title mt-6 max-w-4xl break-words font-display text-[2.2rem] leading-[0.94] sm:text-[3.35rem] lg:text-[4.8rem]">
              {localizedField(lang, leadStory.data.title, leadStory.data.titleEn)}
            </h2>
            <p class="overlay-feature-copy mt-6 max-w-3xl text-[1.08rem] leading-8 sm:text-[1.16rem]">
              {localizedField(lang, leadStory.data.summary, leadStory.data.summaryEn)}
            </p>
            <div class="overlay-feature-meta mt-8 text-sm">{leadStory.data.author}</div>
            <span class="mt-10 inline-flex items-center gap-3 font-display text-[11px] uppercase tracking-[0.24em] text-accent-blue transition-colors duration-300 group-hover:text-white">
              {t['blog.read']} <span aria-hidden="true">→</span>
            </span>
          </div>
        </div>
      </a>
    ) : null}

    {otherStories.length ? (
      <section class="mt-10 grid gap-6 lg:grid-cols-2">
        {otherStories.map((entry) => (
          <a
            href={localizePath(`/blog/${entry.id}/`, lang)}
            class="group overflow-hidden border border-white/10 bg-white/[0.03] transition-colors duration-300 hover:border-accent-blue/50"
          >
            <img src={entry.data.image} alt={localizedField(lang, entry.data.title, entry.data.titleEn)} class="aspect-[16/9] w-full object-cover" />
            <div class="p-7 sm:p-8">
              <div class="flex flex-wrap items-center gap-3 text-sm text-white/48">
                <span class="font-display text-[10px] uppercase tracking-[0.24em] text-warm-gold">{localizedField(lang, entry.data.desk, entry.data.deskEn)}</span>
                <span>•</span>
                <span>{formatLongDate(entry.data.publishedAt)}</span>
              </div>
              <h2 class="mt-5 break-words font-display text-[2rem] leading-none text-white">{localizedField(lang, entry.data.title, entry.data.titleEn)}</h2>
              <p class="mt-5 text-[1.02rem] leading-8 text-white/68">{localizedField(lang, entry.data.summary, entry.data.summaryEn)}</p>
              <div class="mt-8 text-sm text-white/48">{entry.data.author}</div>
              <span class="mt-8 inline-flex items-center gap-3 font-display text-[11px] uppercase tracking-[0.24em] text-white/55 transition-colors duration-300 group-hover:text-accent-blue">
                {t['blog.read']} <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        ))}
      </section>
    ) : null}
  </main>
</SiteLayout>
