---
import { getCollection, render } from 'astro:content';

import EditorialEntryLayout from '../../../layouts/EditorialEntryLayout.astro';
import { localizePath, useTranslations, type Lang } from '../../../i18n/ui';
import { localizedField } from '../../../lib/content';
import { formatLongDate } from '../../../lib/format';

const lang: Lang = 'zh';
const t = useTranslations(lang);

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<EditorialEntryLayout
  lang={lang}
  title={localizedField(lang, entry.data.title, entry.data.titleEn)}
  eyebrow={localizedField(lang, entry.data.desk, entry.data.deskEn)}
  summary={localizedField(lang, entry.data.summary, entry.data.summaryEn)}
  image={entry.data.image}
  backHref={localizePath('/blog/', lang)}
  backLabel={t['back.blog']}
  details={[
    { label: t['detail.published'], value: formatLongDate(entry.data.publishedAt) },
    { label: t['detail.author'], value: entry.data.author },
    { label: t['detail.column'], value: localizedField(lang, entry.data.desk, entry.data.deskEn) },
  ]}
>
  <Content />
</EditorialEntryLayout>
