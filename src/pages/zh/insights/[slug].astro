---
import { getCollection, render } from 'astro:content';

import EntryLayout from '../../../layouts/EntryLayout.astro';
import { localizePath, useTranslations, type Lang } from '../../../i18n/ui';
import { localizedField } from '../../../lib/content';
import { formatLongDate } from '../../../lib/format';

const lang: Lang = 'zh';
const t = useTranslations(lang);

export async function getStaticPaths() {
  const insights = await getCollection('insights');
  return insights.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<EntryLayout
  lang={lang}
  title={localizedField(lang, entry.data.title, entry.data.titleEn)}
  eyebrow={localizedField(lang, entry.data.category, entry.data.categoryEn)}
  summary={localizedField(lang, entry.data.summary, entry.data.summaryEn)}
  image={entry.data.image}
  backHref={localizePath('/insights/', lang)}
  backLabel={t['back.insights']}
  details={[
    { label: t['detail.published'], value: formatLongDate(entry.data.publishedAt) },
    { label: t['detail.readTime'], value: entry.data.readTime },
    { label: t['detail.category'], value: localizedField(lang, entry.data.category, entry.data.categoryEn) },
  ]}
>
  <Content />
</EntryLayout>
