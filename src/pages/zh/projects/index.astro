---
import CollectionIndexLayout from '../../../layouts/CollectionIndexLayout.astro';
import { localizePath, useTranslations, type Lang } from '../../../i18n/ui';
import { getProjectEntries, localizedField } from '../../../lib/content';

const lang: Lang = 'zh';
const t = useTranslations(lang);
const projects = await getProjectEntries();

const toneStyles = {
  green: 'bg-emerald-500/15 text-emerald-400 border-emerald-500/25',
  blue: 'bg-blue-500/15 text-blue-400 border-blue-500/25',
  gold: 'bg-amber-500/15 text-amber-400 border-amber-500/25',
} as const;
---

<CollectionIndexLayout
  lang={lang}
  title="Projects | CHY3"
  eyebrow="Open Source"
  intro="探索 CHY3 开源项目矩阵，涵盖创意工具、变现基础设施和社区驱动的解决方案。"
  description="浏览 CHY3 开源项目集合"
>
  <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
    {projects.map((entry) => (
      <a
        href={localizePath(`/projects/${entry.id}/`, lang)}
        class="group flex h-full flex-col border border-white/10 bg-deep-space-card p-7 transition-colors duration-300 hover:border-accent-blue/50"
      >
        <div class="flex items-start justify-between gap-6">
          <span class="mt-1 font-mono text-sm text-white/30">{entry.data.language}</span>
          <span class={`rounded-full border px-3 py-1 font-display text-[10px] uppercase tracking-[0.22em] ${toneStyles[entry.data.statusTone]}`}>
            {entry.data.status}
          </span>
        </div>
        <h2 class="mt-12 break-words font-display text-[2rem] leading-none text-white">{localizedField(lang, entry.data.title, entry.data.titleEn)}</h2>
        <p class="mt-5 text-[1.02rem] leading-8 text-white/68">{localizedField(lang, entry.data.summary, entry.data.summaryEn)}</p>
        <dl class="mt-8 grid gap-4 text-sm text-white/54">
          <div>
            <dt class="font-display text-[10px] uppercase tracking-[0.22em] text-accent-blue">{t['projects.repo']}</dt>
            <dd class="mt-2 leading-6">{entry.data.repo}</dd>
          </div>
          <div>
            <dt class="font-display text-[10px] uppercase tracking-[0.22em] text-accent-blue">Stars</dt>
            <dd class="mt-2 leading-6">{entry.data.stars}</dd>
          </div>
        </dl>
        <span class="mt-10 inline-flex items-center gap-3 font-display text-[11px] uppercase tracking-[0.24em] text-white/55 transition-colors duration-300 group-hover:text-accent-blue">
          {t['projects.viewProject']} <span aria-hidden="true">→</span>
        </span>
      </a>
    ))}
  </div>
</CollectionIndexLayout>
