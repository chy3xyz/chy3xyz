---
import { getCollection, render } from 'astro:content';

import EntryLayout from '../../../layouts/EntryLayout.astro';
import { localizePath, useTranslations, type Lang } from '../../../i18n/ui';
import { localizedField } from '../../../lib/content';

const lang: Lang = 'zh';
const t = useTranslations(lang);

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<EntryLayout
  lang={lang}
  title={localizedField(lang, entry.data.title, entry.data.titleEn)}
  eyebrow={t['detail.projectEyebrow']}
  summary={localizedField(lang, entry.data.summary, entry.data.summaryEn)}
  image={entry.data.coverImage}
  backHref={localizePath('/projects/', lang)}
  backLabel={t['back.projects']}
  details={[
    { label: t['detail.status'], value: entry.data.status },
    { label: t['projects.repo'], value: entry.data.repo },
    { label: t['detail.language'], value: entry.data.language },
    { label: 'Stars', value: String(entry.data.stars) },
  ]}
>
  <Content />
</EntryLayout>
