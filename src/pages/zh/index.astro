---
import FooterSection from '../../components/FooterSection';
import HeroShell from '../../components/HeroShell';
import ProjectsSection from '../../components/ProjectsSection';
import StatsSection from '../../components/StatsSection';
import RoadmapSection from '../../components/RoadmapSection';
import InsightSection from '../../components/InsightSection';
import {
  footerDirectoryFor,
  footerMetaFor,
  footerPoliciesFor,
  heroContentFor,
  heroLeftPaths,
  heroRightPaths,
  navFor,
  statsFor,
} from '../../data/site';
import { switchLangHref, useTranslations, type Lang } from '../../i18n/ui';
import {
  getProjectEntries,
  getInsightEntries,
  getRoadmapEntries,
  toProjectCard,
  toInsightContent,
  toRoadmapItem,
} from '../../lib/content';
import '../../styles/global.css';

const lang: Lang = 'zh';
const t = useTranslations(lang);

const [projectEntries, insightEntries, roadmapEntries] = await Promise.all([
  getProjectEntries(),
  getInsightEntries(),
  getRoadmapEntries(),
]);

const featuredInsight = insightEntries[0];
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const langHref = switchLangHref(currentPath, lang);
---

<html lang={lang} class="bg-page-bg">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={t['site.description']} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;800;900&family=Space+Grotesk:wght@300;400;500;700&display=swap"
    />
    <script is:inline>
      (() => {
        const key = 'chy3-theme';
        const stored = window.localStorage.getItem(key);
        const theme = stored === 'light' || stored === 'dark' ? stored : 'dark';
        document.documentElement.dataset.theme = theme;
        document.documentElement.classList.toggle('dark', theme === 'dark');
      })();
    </script>
    <title>{t['index.title']}</title>
  </head>
  <body class="bg-page-bg font-body text-white antialiased">
    <main class="site-shell overflow-x-clip">
      <HeroShell
        client:load
        lang={lang}
        langHref={langHref}
        content={heroContentFor(lang)}
        leftNav={navFor(lang, heroLeftPaths)}
        mobileNav={navFor(lang, [...heroLeftPaths, ...heroRightPaths])}
        rightNav={navFor(lang, heroRightPaths)}
      />
      <ProjectsSection client:visible lang={lang} projects={projectEntries.map((entry) => toProjectCard(entry, lang))} />
      {featuredInsight ? (
        <InsightSection
          client:visible
          content={toInsightContent(featuredInsight, lang)}
        />
      ) : null}
      <StatsSection client:visible stats={statsFor(lang)} />
      <RoadmapSection
        client:visible
        lang={lang}
        items={roadmapEntries.map((entry) => toRoadmapItem(entry, lang))}
      />
      <FooterSection
        client:visible
        lang={lang}
        directory={footerDirectoryFor(lang)}
        meta={footerMetaFor(lang)}
        policies={footerPoliciesFor(lang)}
      />
    </main>
  </body>
</html>
