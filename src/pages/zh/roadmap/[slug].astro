---
import { getCollection, render } from 'astro:content';

import EntryLayout from '../../../layouts/EntryLayout.astro';
import { localizePath, useTranslations, type Lang } from '../../../i18n/ui';
import { localizedField } from '../../../lib/content';

const lang: Lang = 'zh';
const t = useTranslations(lang);

export async function getStaticPaths() {
  const roadmapEntries = await getCollection('roadmap');
  return roadmapEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<EntryLayout
  lang={lang}
  title={localizedField(lang, entry.data.title, entry.data.titleEn)}
  eyebrow={t['detail.roadmapEyebrow']}
  summary={localizedField(lang, entry.data.summary, entry.data.summaryEn)}
  backHref={localizePath('/roadmap/', lang)}
  backLabel={t['back.roadmap']}
  details={[
    { label: t['detail.status'], value: t['roadmap.status'][entry.data.status] },
    { label: t['roadmap.quarter'], value: entry.data.quarter },
    { label: t['roadmap.order'], value: String(entry.data.order) },
  ]}
>
  <Content />
</EntryLayout>
