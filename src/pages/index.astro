---
import FooterSection from '../components/FooterSection';
import HeroShell from '../components/HeroShell';
import ProjectsSection from '../components/ProjectsSection';
import StatsSection from '../components/StatsSection';
import RoadmapSection from '../components/RoadmapSection';
import InsightSection from '../components/InsightSection';
import {
  footerDirectory,
  footerMeta,
  footerPolicies,
  heroContent,
  heroLeftNav,
  heroRightNav,
  mobileNav,
  stats,
} from '../data/site';
import {
  getProjectEntries,
  getInsightEntries,
  getRoadmapEntries,
  toProjectCard,
  toInsightContent,
  toRoadmapItem,
} from '../lib/content';
import '../styles/global.css';

const [projectEntries, insightEntries, roadmapEntries] = await Promise.all([
  getProjectEntries(),
  getInsightEntries(),
  getRoadmapEntries(),
]);

const featuredInsight = insightEntries[0];
---

<html lang="zh-CN" class="bg-page-bg">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="CHY3 开源创意变现基础设施 — 构建工具、平台和方法论，帮助创作者将创意转化为可持续价值。"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;800;900&family=Space+Grotesk:wght@300;400;500;700&display=swap"
    />
    <script is:inline>
      (() => {
        const key = 'chy3-theme';
        const stored = window.localStorage.getItem(key);
        const theme = stored === 'light' || stored === 'dark' ? stored : 'dark';
        document.documentElement.dataset.theme = theme;
        document.documentElement.classList.toggle('dark', theme === 'dark');
      })();
    </script>
    <title>CHY3 — 创意变现基础设施</title>
  </head>
  <body class="bg-page-bg font-body text-white antialiased">
    <main class="site-shell overflow-x-clip">
      <HeroShell
        client:load
        content={heroContent}
        leftNav={heroLeftNav}
        mobileNav={mobileNav}
        rightNav={heroRightNav}
      />
      <ProjectsSection client:visible projects={projectEntries.map(toProjectCard)} />
      {featuredInsight ? (
        <InsightSection
          client:visible
          content={toInsightContent(featuredInsight)}
        />
      ) : null}
      <StatsSection client:visible stats={stats} />
      <RoadmapSection
        client:visible
        items={roadmapEntries.map(toRoadmapItem)}
      />
      <FooterSection
        client:visible
        directory={footerDirectory}
        meta={footerMeta}
        policies={footerPolicies}
      />
    </main>
  </body>
</html>
