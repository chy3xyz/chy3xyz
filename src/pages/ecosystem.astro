---
import { render } from 'astro:content';

import SingletonPageLayout from '../layouts/SingletonPageLayout.astro';
import type { Lang } from '../i18n/ui';
import { getPageEntry, localizedField } from '../lib/content';

const lang: Lang = 'en';
const entry = await getPageEntry('ecosystem');
const { Content } = await render(entry);

const highlights = entry.data.highlights.map((item) => ({
  label: localizedField(lang, item.label, item.labelEn),
  value: localizedField(lang, item.value, item.valueEn),
}));
---

<SingletonPageLayout
  lang={lang}
  title={localizedField(lang, entry.data.title, entry.data.titleEn)}
  eyebrow={localizedField(lang, entry.data.eyebrow, entry.data.eyebrowEn)}
  summary={localizedField(lang, entry.data.summary, entry.data.summaryEn)}
  image={entry.data.image}
  highlights={highlights}
>
  <Content />
</SingletonPageLayout>
